#!/bin/bash
#
# create-worktree - cut a git worktree that is ready to work in.
#
# `git worktree add` gives a checkout and nothing else: none of the personal,
# untracked files the old checkout had, and nothing the repository's build system
# needs. This adds both — it copies the files `worktree.copy` names (rewriting the
# old checkout path inside them), then hands the worktree to `worktree-provision`,
# which runs the selected build gates' own provisioning.
#
# It knows nothing about any build system. Everything build-specific lives in
# adapters/build-gate/<kind>/worktree-provision.sh, and the genericity gate holds
# this file to that.
#
# Usage:
#   create-worktree --branch <full-branch-name> --dir <worktree-dir-name> [options]
#
# Required:
#   --branch <name>   Full git branch name. Pre-validated against the repository's own
#                     `git.branch-pattern` before any git call; a repository that declares
#                     no pattern accepts any name.
#                     If it already exists, the worktree attaches to it (--base ignored).
#                     If it doesn't exist, --base is required to create it.
#   --dir <name>      Worktree directory name, created under the base parent dir.
#
# Or, instead of --branch/--dir, a name (the agent path):
#   --name <name>     Worktree name: 1-64 of A-Z a-z 0-9 . _ - (no `..`), checked before any
#                     filesystem or git call. The worktree goes under the current harness's
#                     folder inside the main checkout (hidden through the clone's local
#                     exclude file); the branch is `git.branch-template` with `{name}` and
#                     `{user}` filled when it holds no other placeholder, else `worktree-<name>`.
#                     An owner record and a lock live under the git common directory.
#   --session <id>    Session id to record in the owner record (with --name).
#
# Options:
#   --base <branch>   Base branch to branch from when --branch doesn't exist yet.
#   --track           Pass --track to `git worktree add` (use when the branch will be pushed).
#   --repo <path>     Main repo dir. Default: first entry of `git worktree list` (the main
#                     worktree), else the current toplevel.
#   --parent <path>   Worktree parent dir. Default: the resolved
#                     `worktreeBasePath` — the developer's own value, else a
#                     sibling directory `<main-checkout>-worktrees` derived
#                     from git.
#   --idea-bin <path> IDE launcher. Default: `developer.ideBinary`.
#   --no-configs      Skip copying the files `worktree.copy` names.
#   --no-open         Skip launching the IDE on the new worktree (set by non-interactive callers).
#   --skip-build-gate <kind>
#                     Leave that build gate's provisioning alone. Repeatable.
#   --force-provision Provision again even where a marker says it is already done.
#   --provision-detached
#                     Print WORKTREE_PATH= once the checkout and copies are done; a detached
#                     run of this script then provisions the build and runs the repository's
#                     WorktreeCreated scripts, logging to the worktree's `afk/setup.log` git path.
#
# Internal: `--finish <worktree> --branch <branch> --repo <main>` is that detached run.
#
# Deprecated, still accepted so existing callers keep working:
#   --no-npm          => --skip-build-gate npm
#   --no-m2           => --skip-build-gate maven
#   --m2-seed <path>  => the seed key its adapter documents, set in .afk/config.yaml
#
# Output contract (machine-readable, always the LAST line):
#   success  -> WORKTREE_PATH=<absolute path>
#   failure  -> ERROR=<reason>   (and a non-zero exit; never a bare set-e death)
#
# Per-dev config (a `developer:` block, normally in ~/.afk/config.yaml) supplies
# worktreeBasePath + ideBinary. Both are optional: worktreeBasePath is derived
# when unset, and no IDE is launched without ideBinary.
# (key names owned by CONFIG.md "Developer settings (K1-K5)"); a CLI flag always overrides the config value.

set -u

# --- error contract: every failure path emits a single ERROR= line + non-zero exit --------
error_exit() { echo "ERROR=$1" >&2; exit 1; }
# safety net: any command that fails under set -e trips this instead of dying silently.
# `set -E` (errtrace) is load-bearing — without it the ERR trap is NOT inherited into shell
# functions / command substitutions, so a failure inside a helper (perl/cp/mkdir) would be a
# bare death with no ERROR= line. -E guarantees every failure routes through error_exit.
trap 'error_exit "unexpected failure near line $LINENO"' ERR
set -eE
export AFK_WORKTREE_OP=1   # the backstop passes the plugin's own git calls

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

BRANCH=""
DIR_NAME=""
BASE_BRANCH=""
REPO_DIR=""
WORKTREE_PARENT=""
NAME=""
SESSION_ID=""
FOLDER=""
LOCK_ID=""
LOCK_TOKEN=""
ORPHAN=false
IDEA_BIN=""
TRACK_FLAG=false
CONFIGS_FLAG=true
OPEN_FLAG=true
FORCE_PROVISION=false
PROVISION_DETACHED=false
FINISH_DIR=""
SKIP_GATES=()

deprecated() { echo -e "  ${YELLOW}$1${NC}" >&2; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --branch)     BRANCH="${2:-}"; shift 2 ;;
    --dir)        DIR_NAME="${2:-}"; shift 2 ;;
    --base)       BASE_BRANCH="${2:-}"; shift 2 ;;
    --repo)       REPO_DIR="${2:-}"; shift 2 ;;
    --parent)     WORKTREE_PARENT="${2:-}"; shift 2 ;;
    --name)       NAME="${2:-}"; shift 2 ;;
    --session)    SESSION_ID="${2:-}"; shift 2 ;;
    --idea-bin)   IDEA_BIN="${2:-}"; shift 2 ;;
    --skip-build-gate) SKIP_GATES+=("${2:-}"); shift 2 ;;
    --track)      TRACK_FLAG=true; shift ;;
    --no-configs) CONFIGS_FLAG=false; shift ;;
    --no-open)    OPEN_FLAG=false; shift ;;
    --force-provision) FORCE_PROVISION=true; shift ;;
    --provision-detached) PROVISION_DETACHED=true; shift ;;
    --finish)     FINISH_DIR="${2:-}"; shift 2 ;;
    --no-npm)
      deprecated "--no-npm is deprecated; use --skip-build-gate npm"
      SKIP_GATES+=("npm"); shift ;;
    --no-m2)
      deprecated "--no-m2 is deprecated; use --skip-build-gate maven"
      SKIP_GATES+=("maven"); shift ;;
    --m2-seed)
      deprecated "--m2-seed is deprecated and ignored; set the seed key in .afk/config.yaml"
      shift 2 ;;
    *) error_exit "unknown argument: $1" ;;
  esac
done

# --- branch-name gate: pre-validate against the reference-transaction hook's pattern so a
# non-conforming branch fails HERE with a contract line, not as an opaque hook veto mid-run.
BRANCH_PATTERN=""
AFK_ROOT_DIR="${AFK_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export AFK_PLUGIN_ROOT="$AFK_ROOT_DIR"
PY_BIN="${AFK_PYTHON:-afk-python}"

# The slow tail of a creation: build provisioning, then the repository's WorktreeCreated
# scripts, which are promised a worktree whose build is already set up.
provision_worktree() {   # provision_worktree <worktree>
  local args=(--source "$REPO_DIR" --worktree "$1") gate
  for gate in ${SKIP_GATES+"${SKIP_GATES[@]}"}; do
    args+=(--skip-build-gate "$gate")
  done
  if [[ "$FORCE_PROVISION" == true ]]; then args+=(--force); fi
  bash "$AFK_ROOT_DIR/scripts/worktree-provision" "${args[@]}" >/dev/null \
    || echo -e "  ${RED}Provisioning did not finish — the worktree is usable; see the lines above${NC}" >&2
}

# A failure warns and never removes the worktree. Output goes to stderr so the last
# stdout line stays the contract line.
run_created_scripts() {   # run_created_scripts <worktree> <branch>
  local fwd event_json
  fwd="$(cygpath -m "$1" 2>/dev/null || echo "$1")"
  event_json="$("$PY_BIN" -c 'import json,sys; print(json.dumps({"hook_event_name":"WorktreeCreated","worktree":sys.argv[1],"branch":sys.argv[2]}))' "$fwd" "$2")"
  ( cd "$1" && env -u CLAUDE_PROJECT_DIR -u PROJECT_DIR AFK_WORKTREE_PATH="$fwd" AFK_WORKTREE_BRANCH="$2" \
      "$PY_BIN" "$AFK_ROOT_DIR/hooks/run-hook.py" --soft repo-list WorktreeCreated <<<"$event_json" >&2 ) || true
}

if [[ -n "$FINISH_DIR" ]]; then
  [[ -n "$BRANCH" && -n "$REPO_DIR" && -d "$FINISH_DIR" ]] \
    || error_exit "--finish needs an existing worktree, --branch and --repo"
  provision_worktree "$FINISH_DIR"
  run_created_scripts "$FINISH_DIR" "$BRANCH"
  echo "afk: worktree setup finished" >&2
  exit 0
fi

# The convention belongs to the repository the worktree is being cut FROM, so the
# reader runs with that repository as its working directory - not the caller's.
load_branch_pattern() {
  local repo
  repo="${REPO_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
  [[ -f "$AFK_ROOT_DIR/scripts/afk-config.py" ]] || return 0
  BRANCH_PATTERN="$(cd "$repo" && "$PY_BIN" "$AFK_ROOT_DIR/scripts/afk-config.py" get git.branch-pattern 2>/dev/null)"
}

validate_branch_name() {
  local name="$1"
  [[ -z "$BRANCH_PATTERN" ]] && return 0     # no convention declared => no gate
  [[ "$name" =~ $BRANCH_PATTERN ]]
}

valid_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || return 1
  [[ "$1" != *..* && "$1" != *. && "$1" != *.lock ]]
}

if [[ -n "$NAME" ]]; then
  [[ -z "$BRANCH$DIR_NAME" ]] || error_exit "--name cannot be combined with --branch or --dir"
  NAME="${NAME//\//-}"   # a `/`-separated name (`fix/login`) becomes `fix-login`
  valid_name "$NAME" || error_exit "worktree name '$NAME' is not allowed: use 1-64 of A-Z a-z 0-9 . _ - (a '/' becomes '-') starting with a letter or digit, no '..', not ending in '.' or '.lock'. Example: fix-login"
  OPEN_FLAG=false
else
  [[ -n "$BRANCH" ]]   || error_exit "--branch is required"
  [[ -n "$DIR_NAME" ]] || error_exit "--dir is required"
  load_branch_pattern
  validate_branch_name "$BRANCH" || {
    template="$(cd "${REPO_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}" && "$PY_BIN" "$AFK_ROOT_DIR/scripts/afk-config.py" get git.branch-template 2>/dev/null || true)"
    error_exit "branch '$BRANCH' does not match this repository's git.branch-pattern $BRANCH_PATTERN — no worktree created${template:+. Name it from git.branch-template $template}"
  }
fi

# --- per-dev config: the `developer:` block supplies defaults; CLI flags override ----------
# Read through afk-config.py, which owns discovery and the overlay rules, so this script
# never learns where configuration lives or what format it is in.
read_config_key() {
  local key="$1" repo="$2"
  local script="$AFK_ROOT_DIR/scripts/afk-config.py"
  [[ -f "$script" ]] || {
    if [[ -z "${CFG_WARNED:-}" ]]; then
      CFG_WARNED=1
      echo -e "  ${YELLOW}No afk-config.py under $AFK_ROOT_DIR — ignoring developer defaults; pass --parent/--idea-bin explicitly${NC}" >&2
    fi
    return 0
  }
  # `resolve`, not `get`: it applies the whole chain — the developer's own
  # value from the checkout, repository or machine layer, then the derived one —
  # so this script never learns the order.
  ( cd "$repo" && "$PY_BIN" "$script" resolve "$key" 2>/dev/null ) || true
}

# The session's own checkout: where a new named worktree branches from.
SESSION_DIR="$(git rev-parse --show-toplevel 2>/dev/null || true)"

# Resolve the main repo dir first (config lives under it).
if [[ -z "$REPO_DIR" ]]; then
  # sed (not awk $2) so a main-repo path containing spaces isn't truncated to its first word.
  REPO_DIR="$(git worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | head -1)"
  [[ -n "$REPO_DIR" ]] || REPO_DIR="$(git rev-parse --show-toplevel 2>/dev/null || true)"
fi
[[ -n "$REPO_DIR" ]] || error_exit "could not determine the main repo dir: this folder is not inside a git repository. Start the session inside the repository, or switch into an existing worktree with the harness's worktree tool (its path form), or pass --repo"
[[ -d "$REPO_DIR/.git" || -f "$REPO_DIR/.git" ]] || error_exit "git repo not found at $REPO_DIR"

# The branch a name gets. With a `git.branch-template` that holds a placeholder other
# than `{user}`, the template is expanded: `{user}` is the git user name as a slug
# (`CONFIG.md` "Path templates"), every other placeholder is the name, so a name like
# `PROJ-123` can satisfy a ticket-shaped pattern. Otherwise `worktree-<name>`.
BRANCH_TEMPLATE=""
branch_for_name() {
  local name="$1" user filled
  user="$(git -C "$REPO_DIR" config user.name 2>/dev/null | tr '[:upper:] ' '[:lower:]--' | tr -cd 'a-z0-9-' || true)"
  [[ -n "$user" ]] || user="$name"
  if [[ "${BRANCH_TEMPLATE//\{user\}/}" == *"{"*"}"* ]]; then
    filled="${BRANCH_TEMPLATE//\{user\}/$user}"
    printf '%s\n' "$filled" | sed -E "s/\{[A-Za-z0-9_]+\}/$name/g"
  else
    printf 'worktree-%s\n' "$name"
  fi
}

if [[ -n "$NAME" ]]; then
  # shellcheck source=/dev/null
  source "$AFK_ROOT_DIR/hooks/lib/provider.sh"
  provider_json="$AFK_ROOT_DIR/hooks/lib/providers/$(afk_provider).json"
  provider_json="$(cygpath -m "$provider_json" 2>/dev/null || echo "$provider_json")"
  FOLDER="${AFK_WORKTREE_FOLDER:-$("$PY_BIN" -c 'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8")).get("worktree_folder", ""))' "$provider_json" 2>/dev/null || true)}"
  FOLDER="${FOLDER:-.claude/worktrees}"
  [[ "$FOLDER" != /* && "$FOLDER" != *..* ]] || error_exit "the worktree folder '$FOLDER' must stay inside the repository"
  WORKTREE_PARENT="$REPO_DIR/${FOLDER%/}"
  DIR_NAME="$NAME"
  BRANCH_TEMPLATE="$(cd "$REPO_DIR" && "$PY_BIN" "$AFK_ROOT_DIR/scripts/afk-config.py" get git.branch-template 2>/dev/null || true)"
  BRANCH="$(branch_for_name "$NAME")"
  load_branch_pattern
  validate_branch_name "$BRANCH" || \
    error_exit "branch '$BRANCH' (name '$NAME', git.branch-template '${BRANCH_TEMPLATE:-none}') does not match this repository's git.branch-pattern $BRANCH_PATTERN — no worktree created. The name must make the expanded template match: {user} is your git user name, every other placeholder is filled with the name"
fi


if [[ -z "$WORKTREE_PARENT" ]]; then
  WORKTREE_PARENT="$(read_config_key worktreeBasePath "$REPO_DIR")"
  WORKTREE_SOURCE="developer.worktreeBasePath (or its derived default)"
  if [[ -z "$WORKTREE_PARENT" ]]; then
    # Only reachable when the resolver could not derive one either — a bare
    # clone, or a git dir outside the tree. Say where it landed rather than
    # creating worktrees somewhere the human never named.
    WORKTREE_PARENT="${HOME}/repo-worktrees"
    WORKTREE_SOURCE="last-resort default (set developer.worktreeBasePath or pass --parent)"
  fi
  echo -e "  ${YELLOW}Worktree parent: $WORKTREE_PARENT — $WORKTREE_SOURCE${NC}" >&2
fi
if [[ -z "$IDEA_BIN" ]]; then
  IDEA_BIN="$(read_config_key ideBinary "$REPO_DIR")"
fi

DEST="$WORKTREE_PARENT/$DIR_NAME"
[[ ! -d "$DEST" ]] || error_exit "worktree ${NAME:+name '$NAME' is already taken: }already exists at $DEST"

# A configured base can name a directory under another checkout, including a
# child that does not exist yet. Inspect its nearest existing ancestor before
# Git or mkdir can create anything there.
own_common_dir="$(git -C "$REPO_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
[[ -n "$own_common_dir" ]] || error_exit "could not determine the repository's git common directory"
probe="$WORKTREE_PARENT"
while [[ ! -d "$probe" ]]; do
  parent_probe="$(dirname "$probe")"
  [[ "$parent_probe" != "$probe" ]] || break
  probe="$parent_probe"
done
if [[ -d "$probe" ]]; then
  containing_root="$(git -C "$probe" rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -n "$containing_root" ]]; then
    containing_common_dir="$(git -C "$containing_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    [[ -n "$containing_common_dir" ]] || error_exit "could not determine the containing repository's git common directory"
    own_common_identity="$(cd "$own_common_dir" 2>/dev/null && pwd -P)" || \
      error_exit "could not normalize the repository's git common directory"
    containing_common_identity="$(cd "$containing_common_dir" 2>/dev/null && pwd -P)" || \
      error_exit "could not normalize the containing repository's git common directory"
    own_common_identity="$(printf '%s' "$own_common_identity" | tr '[:upper:]' '[:lower:]')"
    containing_common_identity="$(printf '%s' "$containing_common_identity" | tr '[:upper:]' '[:lower:]')"
    [[ "$containing_common_identity" == "$own_common_identity" ]] || \
      error_exit "worktree parent '$WORKTREE_PARENT' is inside a different Git repository at '$containing_root'"
  fi
fi

# Paths a copy walk never enters: the worktrees already cut from this checkout,
# and the folder new ones go in, whether or not it lies under a copied directory.
PRUNE_PATHS=()
while IFS= read -r wt; do
  [[ -n "$wt" && "$wt" != "$REPO_DIR" ]] && PRUNE_PATHS+=("$wt")
done < <(git -C "$REPO_DIR" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')
[[ "$WORKTREE_PARENT" == "$REPO_DIR"/* ]] && PRUNE_PATHS+=("${WORKTREE_PARENT%/}")
while IFS= read -r manifest; do
  provider_folder="$("$PY_BIN" -c 'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8")).get("worktree_folder", ""))' "$manifest")" || \
    error_exit "could not read provider worktree folder from $manifest"
  [[ -n "$provider_folder" ]] || continue
  [[ "$provider_folder" != /* && "$provider_folder" != *..* ]] || \
    error_exit "provider worktree folder '$provider_folder' must stay inside the repository"
  PRUNE_PATHS+=("$REPO_DIR/${provider_folder%/}")
done < <(find "$AFK_ROOT_DIR/hooks/lib/providers" -maxdepth 1 -type f -name '*.json' -print | sort)

# --- what to carry over. One list, read from configuration, so a repository whose personal
# files live elsewhere changes a config key instead of this script.
# shellcheck source=/dev/null
source "$AFK_ROOT_DIR/hooks/lib/config.sh"
COPY_ENTRIES=()
COPY_PERSONAL=true
COPY_CLAUDE_MD=true
if [[ -f "$AFK_ROOT_DIR/scripts/afk-config.py" ]]; then
  pushd "$REPO_DIR" >/dev/null
  while IFS= read -r entry; do
    [[ -n "$entry" ]] && COPY_ENTRIES+=("$entry")
  done < <(afk_config_list worktree.copy || true)
  afk_config_load
  COPY_PERSONAL="${AFK_CFG_WORKTREE_COPY_PERSONAL:-true}"
  COPY_CLAUDE_MD="${AFK_CFG_WORKTREE_COPY_IGNORED_CLAUDE_MD:-true}"
  popd >/dev/null
fi

# --- path variants for substitution (main repo -> worktree), covering how the main-repo path
# appears in copied text files: Windows forward-slash, backslash, and JSON-escaped backslash.
# Derived from the true Windows forms of REPO_DIR and DEST via cygpath (Git-Bash), so a custom
# --parent is honoured. Filesystem ops below always use the posix $REPO_DIR / $DEST.
REPO_DIR_FWD="$(cygpath -m "$REPO_DIR" 2>/dev/null || echo "$REPO_DIR")"
DEST_DIR_FWD="$(cygpath -m "$DEST" 2>/dev/null || echo "$DEST")"
REPO_DIR_BACK="${REPO_DIR_FWD//\//\\}"
DEST_DIR_BACK="${DEST_DIR_FWD//\//\\}"
REPO_DIR_BACK2="${REPO_DIR_BACK//\\/\\\\}"
DEST_DIR_BACK2="${DEST_DIR_BACK//\\/\\\\}"

# Rewrite $src's main-repo path references to the worktree path and write to $dest.
# perl \Q...\E matches/replaces backslash-heavy Windows paths literally (sed would misread them).
substitute_paths() {
  local src="$1" dest="$2"
  OLD1="$REPO_DIR_FWD" NEW1="$DEST_DIR_FWD" \
  OLD2="$REPO_DIR_BACK" NEW2="$DEST_DIR_BACK" \
  OLD3="$REPO_DIR_BACK2" NEW3="$DEST_DIR_BACK2" \
  perl -pe '
    s/\Q$ENV{OLD1}\E/$ENV{NEW1}/g;
    s/\Q$ENV{OLD2}\E/$ENV{NEW2}/g;
    s/\Q$ENV{OLD3}\E/$ENV{NEW3}/g;
  ' "$src" > "$dest"
}

# Copy one file, rewriting main-repo path references if present. grep -I treats binaries as
# non-matching, so they always fall through to a plain copy.
COPIED_FILES=()
copy_file_with_substitution() {
  local src="$1" dest="$2"
  mkdir -p "$(dirname "$dest")"
  if grep -Iq -F -e "$REPO_DIR_FWD" -e "$REPO_DIR_BACK" -e "$REPO_DIR_BACK2" "$src" 2>/dev/null; then
    substitute_paths "$src" "$dest"
  else
    cp "$src" "$dest"
  fi
  COPIED_FILES+=("${dest#"$DEST"/}")
}

# Recursively copy a directory (incl. subfolders), rewriting paths file-by-file.
# Optional $3: a `find -name` pattern to skip — for per-worktree state that must NOT be
# cloned into a fresh worktree (e.g. .claude/TODO.md, the /afk:todo list).
copy_dir_with_substitution() {
  local src_dir="$1" dest_dir="$2" skip_name="${3:-}"
  [[ -d "$src_dir" ]] || return 0
  mkdir -p "$dest_dir"
  local prune=() p
  for p in ${PRUNE_PATHS+"${PRUNE_PATHS[@]}"}; do
    [[ ${#prune[@]} -gt 0 ]] && prune+=(-o)
    prune+=(-path "$p")
  done
  local walk=()
  [[ ${#prune[@]} -gt 0 ]] && walk=(-type d '(' "${prune[@]}" ')' -prune -o)
  while IFS= read -r -d '' f; do
    rel="${f#"$src_dir"/}"
    copy_file_with_substitution "$f" "$dest_dir/$rel"
  done < <(find "$src_dir" ${walk+"${walk[@]}"} -type f ${skip_name:+-not -name "$skip_name"} -print0 || true)  # || true: keep a find traversal error under set -E from firing the ERR trap (spurious ERROR=)
}

COMMON_DIR="$own_common_dir"

# The lock holder as `pid:creation-time`, in the process table's own terms.
holder_id() {
  local pid=$$
  [[ -r /proc/$$/winpid ]] && pid="$(cat /proc/$$/winpid)"
  printf '%s:%s' "$pid" "$("$PY_BIN" "$AFK_ROOT_DIR/scripts/worktree_owner.py" ctime "$pid")"
}

release_lock() {
  if [[ -n "$LOCK_TOKEN" ]]; then
    "$PY_BIN" "$AFK_ROOT_DIR/scripts/worktree_owner.py" lock-release --repo "$REPO_DIR" \
      --ref refs/afk/locks/worktree-create --token "$LOCK_TOKEN" || true
  fi
  LOCK_TOKEN=""
}

# One creator at a time per checkout. The Git ref update makes stale-lock removal conditional,
# so a waiter cannot delete a replacement lock after the first holder exits.
acquire_lock() {
  LOCK_ID="$(holder_id)"
  LOCK_TOKEN="$("$PY_BIN" "$AFK_ROOT_DIR/scripts/worktree_owner.py" lock-acquire --repo "$REPO_DIR" \
    --ref refs/afk/locks/worktree-create --pid "${LOCK_ID%%:*}" --ctime "${LOCK_ID#*:}")" \
    || error_exit "another worktree creation holds the repository lock"
  trap release_lock EXIT
}

if [[ -n "$NAME" ]]; then
  acquire_lock
  # A new worktree continues where the session is: the HEAD commit of the session's own
  # checkout, never the main checkout's unless they are the same.
  if [[ -z "$BASE_BRANCH" ]]; then
    session_common=""
    [[ -z "$SESSION_DIR" ]] || session_common="$(git -C "$SESSION_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    base_from="$REPO_DIR"
    [[ "$session_common" != "$COMMON_DIR" ]] || base_from="$SESSION_DIR"
    BASE_BRANCH="$(git -C "$base_from" rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null || true)"
    [[ -n "$BASE_BRANCH" ]] || ORPHAN=true
  fi
  [[ ! -e "$DEST" && ! -e "$COMMON_DIR/afk-worktrees/$NAME.json" ]] || error_exit "worktree name '$NAME' is already taken"
  ! git -C "$REPO_DIR" rev-parse --verify -q "refs/heads/$BRANCH" >/dev/null || error_exit "branch '$BRANCH' already exists; choose another name"
fi

echo -e "${YELLOW}Pruning stale worktrees...${NC}" >&2
git -C "$REPO_DIR" worktree prune

echo -e "${YELLOW}Creating worktree at $DEST...${NC}" >&2
mkdir -p "$WORKTREE_PARENT"

BRANCH_EXISTS=false
if git -C "$REPO_DIR" rev-parse --verify "$BRANCH" &>/dev/null; then
  BRANCH_EXISTS=true
fi

if [[ "$BRANCH_EXISTS" == true ]]; then
  git -C "$REPO_DIR" worktree add "$DEST" "$BRANCH" >&2 \
    || error_exit "git worktree add failed for existing branch '$BRANCH'"
elif [[ "$ORPHAN" == true ]]; then
  # No commit yet: an orphan branch, so the first commit can be made in a worktree.
  git -C "$REPO_DIR" worktree add --orphan -b "$BRANCH" "$DEST" >&2 \
    || error_exit "this repository has no commit yet and this git cannot create an orphan worktree (needs git 2.42). A human makes the first commit by starting the session with AFK_ALLOW_PROTECTED=1"
else
  [[ -n "$BASE_BRANCH" ]] \
    || error_exit "branch '$BRANCH' does not exist and --base was not given"
  git -C "$REPO_DIR" rev-parse --verify "$BASE_BRANCH" &>/dev/null \
    || error_exit "base branch '$BASE_BRANCH' does not exist in $REPO_DIR"
  if [[ "$TRACK_FLAG" == true ]]; then
    git -C "$REPO_DIR" worktree add --track -b "$BRANCH" "$DEST" "$BASE_BRANCH" >&2 \
      || error_exit "git worktree add --track failed for '$BRANCH'"
  else
    git -C "$REPO_DIR" worktree add -b "$BRANCH" "$DEST" "$BASE_BRANCH" >&2 \
      || error_exit "git worktree add failed for '$BRANCH'"
  fi
fi

if [[ -n "$NAME" ]]; then
  # Hide the folder from the main checkout's `git status`, once, under the lock.
  exclude="$COMMON_DIR/info/exclude"
  mkdir -p "$COMMON_DIR/info"
  grep -qxF "/${FOLDER%/}/" "$exclude" 2>/dev/null || printf '/%s/\n' "${FOLDER%/}" >> "$exclude"
  # Gate cache and metrics that older plugin versions wrote in the tree must not read as work.
  while IFS= read -r runtime; do
    runtime="${runtime%$'\r'}"
    [[ -n "$runtime" ]] && { grep -qxF "/$runtime" "$exclude" 2>/dev/null || printf '/%s\n' "$runtime" >> "$exclude"; }
  done < <("$PY_BIN" "$AFK_ROOT_DIR/scripts/worktree_owner.py" runtime-paths)
  "$PY_BIN" "$AFK_ROOT_DIR/scripts/worktree_owner.py" record --dir "$COMMON_DIR/afk-worktrees" \
    --name "$NAME" --path "$DEST_DIR_FWD" --branch "$BRANCH" --harness "$(afk_provider)" \
    --session "$SESSION_ID" >&2 || echo -e "  ${YELLOW}Could not write the owner record; the worktree will not be pruned automatically${NC}" >&2
  release_lock
fi

if [[ "$CONFIGS_FLAG" == true && "$COPY_PERSONAL" == true ]]; then
  for entry in ${COPY_ENTRIES+"${COPY_ENTRIES[@]}"}; do
    entry_src="$REPO_DIR/$entry"
    if [[ -f "$entry_src" ]]; then
      copy_file_with_substitution "$entry_src" "$DEST/$entry"
      echo -e "${GREEN}Copied $entry${NC}" >&2
    elif [[ -d "$entry_src" ]]; then
      # TODO.md is the /afk:todo list — per-worktree state, never cloned.
      copy_dir_with_substitution "$entry_src" "$DEST/$entry" "TODO.md"
      echo -e "${GREEN}Copied $entry/${NC}" >&2
      if [[ "$entry" == ".idea" ]]; then
        # Mark this as a portable worktree project (IntelliJ uses .name if present)
        echo "$DIR_NAME" > "$DEST/.idea/.name"
        COPIED_FILES+=(".idea/.name")
      fi
    fi
  done

  if [[ "$COPY_CLAUDE_MD" == true ]]; then
    # Ignored AGENTS.md / CLAUDE.md files are personal instructions git will never carry over.
    CLAUDE_MD_COUNT=0
    while IFS= read -r relpath; do
      [[ -z "$relpath" ]] && continue
      copy_file_with_substitution "$REPO_DIR/$relpath" "$DEST/$relpath"
      CLAUDE_MD_COUNT=$((CLAUDE_MD_COUNT + 1))
    done < <(git -C "$REPO_DIR" ls-files --others --ignored --exclude-standard | grep -E '(^|/)(AGENTS|CLAUDE)\.md$' || true)
    if (( CLAUDE_MD_COUNT > 0 )); then
      echo -e "${GREEN}Copied $CLAUDE_MD_COUNT instruction file(s)${NC}" >&2
    fi
  fi
fi

# Worktree removal keeps a worktree whose copied files changed; it reads these hashes.
if (( ${#COPIED_FILES[@]} > 0 )); then
  printf '%s\0' "${COPIED_FILES[@]}" | "$PY_BIN" "$AFK_ROOT_DIR/scripts/worktree_owner.py" copied \
    --worktree "$DEST_DIR_FWD" >&2 \
    || echo -e "  ${YELLOW}Could not record the copied files; removal keeps this worktree if they look like work${NC}" >&2
fi

# --- hand the worktree to the build gates. Their provisioning is theirs: this script only
# says which worktree it is, and which gates the caller asked to leave alone.
if [[ "$PROVISION_DETACHED" == true ]]; then
  SETUP_LOG="$(git -C "$DEST" rev-parse --path-format=absolute --git-path afk/setup.log)"
  SETUP_LOG="$(cygpath -m "$SETUP_LOG" 2>/dev/null || echo "$SETUP_LOG")"
  mkdir -p "$(dirname "$SETUP_LOG")"
  FINISH_ARGS=(--finish "$DEST" --branch "$BRANCH" --repo "$REPO_DIR")
  for gate in ${SKIP_GATES+"${SKIP_GATES[@]}"}; do
    FINISH_ARGS+=(--skip-build-gate "$gate")
  done
  if [[ "$FORCE_PROVISION" == true ]]; then FINISH_ARGS+=(--force-provision); fi
  # The caller's hook budget must not reach the detached run, which outlives the caller.
  if env -u AFK_HOOK_DEADLINE "$PY_BIN" - "$(cygpath -m "$AFK_ROOT_DIR/hooks/lib/h2_move.py" 2>/dev/null || echo "$AFK_ROOT_DIR/hooks/lib/h2_move.py")" \
      "$SETUP_LOG" "$(cygpath -m "$BASH" 2>/dev/null || echo "$BASH")" \
      "$(cygpath -m "$AFK_ROOT_DIR/scripts/create-worktree" 2>/dev/null || echo "$AFK_ROOT_DIR/scripts/create-worktree")" \
      "${FINISH_ARGS[@]}" <<'PY'
import importlib.util, sys
spec = importlib.util.spec_from_file_location("afk_h2_move", sys.argv[1])
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
module.spawn(sys.argv[3:], log=sys.argv[2])
PY
  then
    echo -e "  ${YELLOW}Build setup continues in the background; progress: $SETUP_LOG${NC}" >&2
  else
    echo -e "  ${RED}Could not start the background build setup; the worktree is usable. Run: create-worktree ${FINISH_ARGS[*]}${NC}" >&2
  fi
else
  provision_worktree "$DEST"
fi

if [[ "$OPEN_FLAG" == true ]]; then
  if [[ -n "$IDEA_BIN" ]]; then
    echo -e "${YELLOW}Opening IDE...${NC}" >&2
    # DEST_DIR_FWD (cygpath -m) — a native IDE binary can't resolve a /c/... POSIX path.
    "$IDEA_BIN" "$DEST_DIR_FWD" & disown 2>/dev/null || true
  else
    echo -e "  ${YELLOW}No developer.ideBinary configured and no --idea-bin — skipping IDE launch${NC}" >&2
  fi
fi

# Repository setup scripts (the `WorktreeCreated` event of the repository hook manifest).
[[ "$PROVISION_DETACHED" == true ]] || run_created_scripts "$DEST" "$BRANCH"

echo -e "${GREEN}Worktree ready: $DEST${NC}" >&2
echo "WORKTREE_PATH=$DEST"
