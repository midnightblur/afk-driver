{
  "kind": "github",
  "family": "forge",
  "name": "forge/github",
  "operations": [
    "change-view",
    "change-diff",
    "change-create-draft",
    "change-ready",
    "change-reviewers",
    "change-update-body",
    "change-comment",
    "change-state",
    "change-close",
