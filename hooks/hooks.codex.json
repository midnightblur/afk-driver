{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/run-hook.py\" --soft plugin install-git-hooks.sh --quiet",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/run-hook.py\" --soft plugin update-notice.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/run-hook.py\" --soft plugin agents-md-config-check.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/run-hook.py\" --soft repo-list SessionStart",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/run-hook.py\" --soft plugin nested-steering.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/run-hook.py\" plugin lavish-dark.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/run-hook.py\" plugin lavish-tips.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/run-hook.py\" repo-list PreToolUse",
            "timeout": 60,
            "statusMessage": "repository PreToolUse hooks"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/run-hook.py\" --soft plugin nested-steering.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/run-hook.py\" repo-list PostToolUse",
            "timeout": 60,
            "statusMessage": "repository PostToolUse hooks"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/run-hook.py\" --soft plugin nested-steering.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/run-hook.py\" --soft repo-list PostCompact",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/run-hook.py\" plugin stop-gates.sh",
            "timeout": 300,
            "statusMessage": "AFK gates..."
          },
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/run-hook.py\" repo-list Stop",
            "timeout": 300,
            "statusMessage": "repository Stop gates"
          }
        ]
      }
    ]
  }
}
