{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --soft --deadline 14 plugin install-git-hooks.sh --quiet",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --soft --deadline 14 plugin update-notice.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --soft --deadline 14 plugin agents-md-config-check.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --soft --deadline 14 plugin behavior-drift.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --soft --deadline 57 repo-list SessionStart",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --soft --deadline 57 plugin worktree-prune.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/protected-branch-occupancy.py\"",
            "timeout": 30,
            "statusMessage": "protected-branch occupancy"
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --soft --deadline 14 plugin nested-steering.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --deadline 14 plugin lavish-dark.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --deadline 14 plugin lavish-tips.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --deadline 57 repo-list PreToolUse",
            "timeout": 60,
            "statusMessage": "repository PreToolUse hooks"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/protected-branch-guard.py\"",
            "timeout": 30,
            "statusMessage": "protected-branch guard"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --deadline 570 plugin worktree-create.sh",
            "timeout": 600,
            "statusMessage": "creating worktree"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --soft --deadline 14 plugin nested-steering.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --deadline 57 repo-list PostToolUse",
            "timeout": 60,
            "statusMessage": "repository PostToolUse hooks"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/protected-branch-meter.py\"",
            "timeout": 30,
            "statusMessage": "protected-branch change meter"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --soft --deadline 14 plugin nested-steering.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --soft --deadline 57 repo-list PostCompact",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --deadline 285 plugin stop-gates.sh",
            "timeout": 300,
            "statusMessage": "AFK gates..."
          },
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --deadline 285 repo-list Stop",
            "timeout": 300,
            "statusMessage": "repository Stop gates"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --soft --deadline 114 plugin worktree-remove.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afk-python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --soft --deadline 114 plugin worktree-remove.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
