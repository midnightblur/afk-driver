{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" --soft plugin install-git-hooks.sh --quiet",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" plugin lavish-dark.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" plugin lavish-tips.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Glob|Grep|mcp__lean-ctx__ctx_search|mcp__lean-ctx__ctx_tree",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" repo crowdstrike-guard.sh",
            "timeout": 15,
            "statusMessage": "crowdstrike-guard: checking for system-root recursive scan"
          }
        ]
      },
      {
        "matcher": "Grep|mcp__lean-ctx__ctx_search|mcp__lean-ctx__ctx_semantic_search|mcp__intellij__search_in_files_by_regex|mcp__intellij__search_in_files_by_text|mcp__intellij__search_text|mcp__intellij__search_regex",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" repo explore-counter.sh",
            "timeout": 15,
            "statusMessage": "explore-counter: tallying search calls"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" plugin stop-gates.sh",
            "timeout": 300,
            "statusMessage": "AFK gates..."
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" repo java-rules-gate.sh",
            "timeout": 300,
            "statusMessage": "java-rules-gate: checking changed .java against the CSJ rules"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.py\" repo i18n-parity-gate.sh",
            "timeout": 60,
            "statusMessage": "i18n-parity-gate: checking added caption keys across locales"
          }
        ]
      }
    ]
  }
}
