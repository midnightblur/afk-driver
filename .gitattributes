# Every shell script here runs under git-bash, and a harness copies this tree
# verbatim into its plugin cache. The repo default core.autocrlf=true would
# CRLF-ify them on checkout; git-bash then fails on the shebang and `set` lines,
# taking the whole hook surface (guards, Stop gates, provider shim) with it.
*.sh text eol=lf

# The hook launcher and the python modules its handlers import are executed by
# the same copied tree; keep them LF for the same reason (gate rule I covers
# hooks/**/*.py).
hooks/**/*.py text eol=lf

# The worktree scripts run under git-bash as well: same rule, same reason.
scripts/create-worktree text eol=lf
scripts/worktree-provision text eol=lf
scripts/remove-worktree text eol=lf
scripts/afk-launch text eol=lf
scripts/worktree_owner.py text eol=lf
scripts/protected-lookup.py text eol=lf
